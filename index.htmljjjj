;(()=>{const z=()=>{try{const t=performance.now();debugger;return performance.now()-t>120}catch(e){return false}};let n=false;setInterval(()=>{if(z()&&!n){n=true;document.documentElement.setAttribute("data-debug","1");}},1800);const c=window.console;["log","debug","info","warn","error","dir","table","trace"].forEach(k=>{try{c[k]=()=>{}}catch(e){}});})();

