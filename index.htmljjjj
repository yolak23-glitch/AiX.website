<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0f0f12">
<title>AiX - APK Showcase Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0f0f12;--bg2:#16161a;--pu:#7c3aed;--bl:#3b82f6;--tx:#ececf3;--mut:#9494a8;--bd:rgba(255,255,255,.09);--glass:rgba(255,255,255,.04);--grad:linear-gradient(135deg,#7c3aed,#3b82f6)}
html{scroll-behavior:smooth}
body{font:400 15px/1.55 Inter,system-ui,sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(600px 420px at 88% -4%,rgba(124,58,237,.28),transparent),radial-gradient(520px 420px at -6% 42%,rgba(59,130,246,.17),transparent),var(--bg)}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
:focus-visible{outline:2px solid var(--bl);outline-offset:2px}
.wrap{max-width:1180px;margin:0 auto;padding:0 16px}

/* Header */
header{position:sticky;top:0;z-index:50;background:rgba(15,15,18,.72);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--bd)}
.bar{display:flex;align-items:center;justify-content:space-between;height:62px}
.logo{display:flex;align-items:center;gap:10px;font:700 25px Poppins,sans-serif;letter-spacing:-.5px;text-shadow:0 0 18px rgba(124,58,237,.95)}
.logo i{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:var(--grad);font-size:15px;text-shadow:none;box-shadow:0 0 22px rgba(124,58,237,.75)}
.logo b{color:var(--bl);text-shadow:0 0 18px rgba(59,130,246,.95)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 18px;border-radius:12px;font:600 14px Poppins,sans-serif;transition:.2s;white-space:nowrap}
.btn-neon{background:var(--grad);color:#fff}
.btn-neon:hover{box-shadow:0 0 24px rgba(124,58,237,.7);transform:translateY(-1px)}
.btn-ghost{border:1px solid var(--bd);background:var(--glass)}
.btn-ghost:hover{border-color:var(--pu)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.sm{padding:9px 14px;font-size:13px;flex:1}
.big{width:100%;padding:14px;font-size:15px;margin-top:18px}

/* Hero slider */
.hero{position:relative;height:360px;margin:20px 0 0;border-radius:24px;overflow:hidden;border:1px solid var(--bd);box-shadow:0 0 44px rgba(124,58,237,.2)}
.slide{position:absolute;inset:0;display:flex;align-items:flex-end;padding:24px;opacity:0;visibility:hidden;transition:opacity .6s,visibility .6s;background-size:cover;background-position:center}
.slide.on{opacity:1;visibility:visible}
.slide:before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(15,15,18,.96) 10%,rgba(15,15,18,.4) 68%,rgba(15,15,18,.1))}
.slide>div{position:relative;max-width:580px}
.tag{display:inline-flex;align-items:center;gap:7px;padding:5px 12px;border-radius:99px;font:600 12px Inter;background:rgba(124,58,237,.25);border:1px solid rgba(124,58,237,.6);backdrop-filter:blur(8px);margin-bottom:12px}
.slide h2{font:700 clamp(26px,6vw,44px)/1.12 Poppins,sans-serif;letter-spacing:-.8px;text-shadow:0 0 30px rgba(124,58,237,.5)}
.slide p{color:#c4c4d4;margin:10px 0 18px;max-width:46ch}
.ctl{position:absolute;top:16px;right:16px;z-index:5;display:flex;align-items:center;gap:6px;padding:6px;border-radius:99px;background:rgba(15,15,18,.55);backdrop-filter:blur(10px);border:1px solid var(--bd)}
.ctl button{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:12px;color:var(--mut)}
.ctl button:hover{color:#fff;background:var(--glass)}
.dot{width:7px!important;height:7px!important;padding:0;background:rgba(255,255,255,.3)!important;transition:.25s}
.dot.on{width:22px!important;border-radius:99px!important;background:var(--grad)!important}

/* Search & filters */
.tools{display:flex;flex-direction:column;gap:14px;margin:26px 0 18px}
.search{position:relative}
.search>i{position:absolute;left:17px;top:50%;transform:translateY(-50%);color:var(--mut);pointer-events:none}
.search input{width:100%;padding:15px 46px 15px 46px;border-radius:16px;border:1px solid var(--bd);background:var(--glass);backdrop-filter:blur(12px);color:var(--tx);font:inherit;outline:0;transition:.2s}
.search input:focus{border-color:var(--pu);box-shadow:0 0 0 4px rgba(124,58,237,.18),0 0 26px rgba(124,58,237,.28)}
.clr{position:absolute;right:9px;top:50%;transform:translateY(-50%);width:32px;height:32px;border-radius:50%;color:var(--mut);display:none}
.clr.on{display:block}
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 2px 6px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.cf{flex:none;padding:9px 18px;border-radius:99px;border:1px solid var(--bd);background:var(--glass);color:var(--mut);font:500 14px Inter;transition:.2s}
.cf:hover{color:var(--tx);border-color:var(--pu)}
.cf.on{background:var(--grad);color:#fff;border-color:transparent;box-shadow:0 0 20px rgba(124,58,237,.55)}
.head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px}
.head h3{font:600 20px Poppins,sans-serif}
.head span{color:var(--mut);font-size:13px}

/* Cards */
.grid{display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:640px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}.hero{height:440px}.slide{padding:44px}}
.card{display:flex;flex-direction:column;gap:12px;padding:18px;border-radius:20px;border:1px solid var(--bd);background:linear-gradient(160deg,rgba(255,255,255,.07),rgba(255,255,255,.02));backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);cursor:pointer;transition:.25s;animation:in .45s both}
.card:hover{transform:translateY(-4px);border-color:rgba(124,58,237,.65);box-shadow:0 14px 42px rgba(124,58,237,.24)}
@keyframes in{from{opacity:0;transform:translateY(12px)}}
.top{display:flex;align-items:center;gap:14px}
.top h4{font:600 17px/1.25 Poppins,sans-serif}
.sub{color:var(--mut);font-size:13px}
.ico{position:relative;flex:none;width:58px;height:58px;border-radius:17px;overflow:hidden;display:grid;place-items:center;font:700 20px Poppins,sans-serif;color:#fff;background:linear-gradient(135deg,hsl(var(--h) 80% 56%),hsl(calc(var(--h) + 50) 80% 42%));box-shadow:0 0 20px hsl(var(--h) 80% 50%/.4)}
.ico img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.vt{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.ver,.bdg{font:600 11px Poppins,sans-serif;padding:3px 9px;border-radius:8px}
.ver{background:rgba(59,130,246,.15);color:#8db8ff;border:1px solid rgba(59,130,246,.4)}
.bdg{background:rgba(124,58,237,.2);color:#c4a8ff;border:1px solid rgba(124,58,237,.5)}
.desc{color:#b4b4c6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;flex:1}
.rate{display:inline-flex;align-items:center;gap:6px;font-weight:600}
.rate i{color:#fbbf24}
.rs{display:flex;justify-content:space-between;color:var(--mut);font-size:13px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{font:600 10.5px Inter;letter-spacing:.4px;padding:4px 9px;border-radius:7px;color:#a5b4fc;background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.3)}
.acts{display:flex;gap:8px}

/* Empty state */
.empty{display:none;text-align:center;padding:48px 20px;border-radius:20px;border:1px dashed rgba(124,58,237,.5);background:var(--glass)}
.empty.on{display:block}
.empty i{font-size:38px;color:var(--pu);filter:drop-shadow(0 0 14px rgba(124,58,237,.8));margin-bottom:14px}
.empty h4{font:600 18px Poppins,sans-serif}
.empty p{color:var(--mut);margin:6px 0 18px}

/* Modal */
.ov{position:fixed;inset:0;z-index:100;display:none;align-items:flex-end;justify-content:center;background:rgba(5,5,8,.72);backdrop-filter:blur(6px)}
.ov.on{display:flex}
.modal{position:relative;width:100%;max-width:560px;max-height:90vh;overflow:auto;padding:24px 20px;border-radius:24px 24px 0 0;background:var(--bg2);border:1px solid var(--bd);box-shadow:0 0 70px rgba(124,58,237,.35);animation:up .3s}
@keyframes up{from{transform:translateY(40px);opacity:0}}
@media(min-width:640px){.ov{align-items:center}.modal{border-radius:24px;padding:28px}}
.x{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:50%;background:var(--glass);border:1px solid var(--bd);color:var(--mut)}
.x:hover{color:#fff}
.mh{display:flex;gap:16px;align-items:center;margin-bottom:18px;padding-right:36px}
.mh h3{font:700 22px Poppins,sans-serif}
.mh .vt{margin-top:6px}
.det{color:#c4c4d4;margin-bottom:18px}
.meta{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px}
.meta div{padding:12px 8px;text-align:center;border-radius:14px;background:var(--glass);border:1px solid var(--bd)}
.meta b{display:block;font:600 14px Poppins,sans-serif}
.meta span{font-size:12px;color:var(--mut)}

/* Footer */
footer{margin-top:56px;padding:30px 0 36px;border-top:1px solid var(--bd);background:rgba(22,22,26,.6)}
.ft{display:flex;flex-direction:column;gap:18px;align-items:center;text-align:center}
.ok{display:inline-flex;align-items:center;gap:9px;padding:8px 16px;border-radius:99px;font:600 13px Poppins,sans-serif;color:#4ade80;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.4);box-shadow:0 0 20px rgba(34,197,94,.15)}
.fl{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.fl a{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:10px;color:var(--mut);border:1px solid var(--bd);transition:.2s}
.fl a:hover{color:#fff;border-color:var(--pu);box-shadow:0 0 16px rgba(124,58,237,.35)}
.cp{color:var(--mut);font-size:13px}
@media(min-width:760px){.ft{flex-direction:row;justify-content:space-between;text-align:left}}
@media(max-width:480px){.hs{display:none}.btn.dc{padding:10px 14px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <a class="logo" href="#" aria-label="AiX ana sayfa"><i class="fa-solid fa-bolt"></i><span>Ai<b>X</b></span></a>
    <a class="btn btn-neon dc" id="dcBtn" target="_blank" rel="noopener"><i class="fa-brands fa-discord"></i><span class="hs">Discord'a Katıl</span></a>
  </div>
</header>

<main class="wrap">
  <section class="hero" id="hero" aria-label="Öne çıkanlar"></section>

  <div class="tools">
    <div class="search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input id="q" type="search" placeholder="Uygulama, oyun veya etiket ara..." autocomplete="off" aria-label="Uygulama ara">
      <button class="clr" id="clr" aria-label="Aramayı temizle"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="chips" id="chips" role="tablist"></div>
  </div>

  <div class="head"><h3>Uygulamalar</h3><span id="count"></span></div>
  <div class="grid" id="grid"></div>
  <div class="empty" id="empty">
    <i class="fa-regular fa-face-frown-open"></i>
    <h4>Aradığınız uygulama bulunamadı</h4>
    <p id="eq"></p>
    <button class="btn btn-neon" id="reset"><i class="fa-solid fa-rotate-left"></i>Filtreleri sıfırla</button>
  </div>
</main>

<footer>
  <div class="wrap ft">
    <div>
      <div class="ok"><i class="fa-solid fa-shield-halved"></i>Güvenli ve Doğrulanmış APK</div>
      <p class="cp" style="margin-top:12px">© 2026 AiX. Tüm hakları saklıdır.</p>
    </div>
    <nav class="fl" id="links" aria-label="İletişim"></nav>
  </div>
</footer>

<div class="ov" id="ov"><div class="modal" id="modal" role="dialog" aria-modal="true"></div></div>

<script>
